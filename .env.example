# Copy to backend/.env (or the project root .env). All values are optional.
PORT=3001
# Keep 127.0.0.1 so only this computer can reach the app.
HOST=127.0.0.1
# Full paths on Windows if FFmpeg is not in PATH, e.g.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Defaults to ai-service\.venv\Scripts\python.exe when that venv exists, else "python".
# PYTHON_PATH=python
MAX_UPLOAD_GB=20
# Where projects, clips, database and caches live (default: ./storage)
# CLIPFORGE_STORAGE=D:\ClipForgeStorage
